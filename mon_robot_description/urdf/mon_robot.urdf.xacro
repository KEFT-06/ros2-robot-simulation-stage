<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="atawi_3a3">

  <!-- Mesh URI prefix: package:// for RViz, model:// for Gazebo (resolved via GZ_SIM_RESOURCE_PATH) -->
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="controllers_yaml" default=""/>
  <xacro:if value="$(arg use_gazebo)">
    <xacro:property name="mesh_uri" value="model://mon_robot_description/meshes"/>
  </xacro:if>
  <xacro:unless value="$(arg use_gazebo)">
    <xacro:property name="mesh_uri" value="package://mon_robot_description/meshes"/>
  </xacro:unless>

  <!-- Lien "world" UNIQUEMENT hors Gazebo (RViz a besoin d'un repere fixe).
       En Gazebo, la base reste LIBRE pour pouvoir flotter (pas de joint fixe). -->
  <xacro:unless value="$(arg use_gazebo)">
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:unless>

  <!-- ========== BASE / CORPS PRINCIPAL ========== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_uri}/Body.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.097" rpy="0 0 0"/>
      <geometry>
        <box size="0.112 0.063 0.194"/>
      </geometry>
    </collision>
    <inertial>
      <!-- Centre de masse abaisse (lestage / quille) : auto-redressement
           horizontal une fois a flot, comme une bouee. -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0"
               iyy="0.005" iyz="0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ========== HANDLE GAUCHE (fixe) ========== -->
  <joint name="handle1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="handle1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="handle1_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Handle_1.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.010 0.008 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========== HANDLE DROIT (fixe) ========== -->
  <joint name="handle2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="handle2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="handle2_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Handle_2.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="dark_grey2">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.010 0.008 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========== ECROUS (fixes) ========== -->
  <joint name="hexnut1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hexnut1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="hexnut1_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Hexnut_1.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="metal">
        <color rgba="0.8 0.7 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="hexnut2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hexnut2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="hexnut2_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Hexnut_2.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="metal2">
        <color rgba="0.8 0.7 0.2 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- ========== VIS (fixes) ========== -->
  <joint name="vis1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vis1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="vis1_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Vis_1.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="vis2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="vis2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="vis2_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Vis_2.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="silver2">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- ========== L2 PIECES (fixes) ========== -->
  <joint name="l2_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="l2_1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="l2_1_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/L2_1.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="l2_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="l2_2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="l2_2_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/L2_2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue2"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="l2_3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="l2_3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="l2_3_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/L2_3.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue3"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="l2_4_joint" type="fixed">
    <parent link="base_link"/>
    <child link="l2_4_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="l2_4_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/L2_4.stl" scale="1 1 1"/>
      </geometry>
      <material name="blue4"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <!-- ========== JOINT 1 — TETE (part2) ROTATION PRINCIPALE ========== -->
  <joint name="joint1_head" type="revolute">
    <parent link="base_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"
           effort="10.0" velocity="1.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="head_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/part2.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="blue_head">
        <color rgba="0.2 0.4 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.101 0.043 0.039"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ========== JOINT 2 — ROTOR (impeller) ROTATION ========== -->
  <joint name="joint2_rotor" type="revolute">
    <parent link="head_link"/>
    <child link="rotor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159"
           effort="5.0" velocity="10.0"/>
    <dynamics damping="0.1" friction="0.01"/>
  </joint>

  <link name="rotor_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Blade_1.stl"
              scale="1 1 1"/>
      </geometry>
      <material name="blade_color">
        <color rgba="0.9 0.4 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.006"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0"
               iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Pales 2, 3, 4 fixées sur le rotor -->
  <joint name="blade2_joint" type="fixed">
    <parent link="rotor_link"/>
    <child link="blade2_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="blade2_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Blade_2.stl" scale="1 1 1"/>
      </geometry>
      <material name="blade2"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="blade3_joint" type="fixed">
    <parent link="rotor_link"/>
    <child link="blade3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="blade3_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Blade_3.stl" scale="1 1 1"/>
      </geometry>
      <material name="blade3"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="blade4_joint" type="fixed">
    <parent link="rotor_link"/>
    <child link="blade4_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="blade4_link">
    <visual>
      <geometry>
        <mesh filename="${mesh_uri}/Blade_4.stl" scale="1 1 1"/>
      </geometry>
      <material name="blade4"><color rgba="0.9 0.4 0.1 1"/></material>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ========== EFFECTEUR FINAL ========== -->
  <joint name="tool_joint" type="fixed">
    <parent link="rotor_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>
  <link name="tool_link">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="red"><color rgba="1 0 0 1"/></material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0" ixz="0"
               iyy="0.0000001" iyz="0" izz="0.0000001"/>
    </inertial>
  </link>

  <!-- ========== ROS2 CONTROL (Gazebo uniquement) ========== -->
  <xacro:if value="$(arg use_gazebo)">
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint1_head">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint2_rotor">
      <command_interface name="position">
        <param name="min">-3.14159</param>
        <param name="max">3.14159</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>

    <!-- Odometrie 3D du bateau (pose monde -> base_link) pour suivre la
         flottaison et la course temporelle. Publie /model/atawi_3a3/odometry. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>
  </xacro:if>

</robot>
