<?xml version="1.0"?>
<sdf version="1.9">
  <world name="atawi_3a3_ocean_world">
    <gravity>0 0 -9.81</gravity>

    <!-- ======================== GUI / CAMERA PAR DEFAUT ========================
         camera_pose cadre le bateau des l'ouverture. Definir <gui> ici remplace
         la config par defaut, donc on liste les plugins essentiels. -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.62 0.78 0.92</background_color>
        <camera_pose>-9 -7 5 0 0.34 0.66</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="MarkerManager" name="Marker Manager"/>
      <plugin filename="SelectEntities" name="Select Entities"/>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities"/>
      <plugin filename="Spawn" name="Spawn"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="EntityContextMenuPlugin" name="Entity Context Menu"/>
      <plugin filename="ComponentInspector" name="Component inspector"/>
      <plugin filename="TransformControl" name="Transform control"/>
      <plugin filename="Shapes" name="Shapes"/>
      <plugin filename="Lights" name="Lights"/>
      <plugin filename="CopyPaste" name="Copy/Paste"/>
      <plugin filename="Screenshot" name="Screenshot"/>
    </gui>

    <!-- ======================== SYSTEM PLUGINS (Gazebo Harmonic) ======================== -->
    <!-- Obligatoires : sans eux la simulation ne tourne pas et les modeles ne sont
         pas diffuses (spawn / controller_manager indisponibles en headless/Docker). -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Pas de plugin Buoyancy : le bateau est FIXE au monde (URDF: world_to_hull),
         pose a plat sur l'eau et immobile. La surface d'eau reste purement visuelle. -->

    <!-- ======================== PHYSICS ======================== -->
    <!-- Le moteur (dartsim par defaut) est choisi par le plugin Physics ci-dessus. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================== SCENE / SKY ======================== -->
    <scene>
      <ambient>0.55 0.65 0.75 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ======================== LIGHTING ======================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.95 0.82 1</diffuse>
      <specular>0.55 0.55 0.50 1</specular>
      <direction>-0.35 0.20 -0.92</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ======================== WATER SURFACE ======================== -->
    <!-- Plan d'eau purement visuel. La pose du bateau est fixee dans l'URDF. -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_link">
        <!-- Pas de collision : la surface reste uniquement visuelle. -->
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <!-- Eau calme et MATE : specular tres faible => plus de halo/reflet aveuglant
               ni de "bloc" brillant. Plan reduit a 60 m pour degager un horizon. -->
          <material>
            <ambient>0.10 0.28 0.34 1</ambient>
            <diffuse>0.12 0.40 0.52 1</diffuse>
            <specular>0.06 0.10 0.12 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== SUBTLE WAVE MARKERS ======================== -->
    <!-- Crêtes visuelles fines, sans collision ni physique. Elles donnent une
         lecture maritime sans perturber la simulation ROS/Gazebo. -->
    <model name="wave_lines">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="wave_link">
        <visual name="wave_line_1">
          <pose>-2.0 -3.2 0 0 0 0.08</pose>
          <geometry><box><size>12.0 0.020 0.002</size></box></geometry>
          <material>
            <ambient>0.72 0.95 1.00 0.55</ambient>
            <diffuse>0.72 0.95 1.00 0.55</diffuse>
          </material>
        </visual>
        <visual name="wave_line_2">
          <pose>1.6 -2.1 0 0 0 -0.05</pose>
          <geometry><box><size>9.0 0.018 0.002</size></box></geometry>
          <material>
            <ambient>0.70 0.93 0.98 0.45</ambient>
            <diffuse>0.70 0.93 0.98 0.45</diffuse>
          </material>
        </visual>
        <visual name="wave_line_3">
          <pose>-1.0 -0.9 0 0 0 0.11</pose>
          <geometry><box><size>7.0 0.016 0.002</size></box></geometry>
          <material>
            <ambient>0.78 0.98 1.00 0.50</ambient>
            <diffuse>0.78 0.98 1.00 0.50</diffuse>
          </material>
        </visual>
        <visual name="wave_line_4">
          <pose>2.2 0.6 0 0 0 -0.12</pose>
          <geometry><box><size>8.5 0.018 0.002</size></box></geometry>
          <material>
            <ambient>0.72 0.95 1.00 0.48</ambient>
            <diffuse>0.72 0.95 1.00 0.48</diffuse>
          </material>
        </visual>
        <visual name="wave_line_5">
          <pose>-2.8 1.7 0 0 0 0.06</pose>
          <geometry><box><size>10.0 0.018 0.002</size></box></geometry>
          <material>
            <ambient>0.66 0.90 0.96 0.42</ambient>
            <diffuse>0.66 0.90 0.96 0.42</diffuse>
          </material>
        </visual>
        <visual name="wave_line_6">
          <pose>0.8 3.1 0 0 0 -0.08</pose>
          <geometry><box><size>13.0 0.020 0.002</size></box></geometry>
          <material>
            <ambient>0.76 0.97 1.00 0.52</ambient>
            <diffuse>0.76 0.97 1.00 0.52</diffuse>
          </material>
        </visual>
        <visual name="near_ripple_left">
          <pose>-0.20 0.26 0.001 0 0 0.18</pose>
          <geometry><box><size>0.65 0.012 0.002</size></box></geometry>
          <material>
            <ambient>0.90 1.00 1.00 0.70</ambient>
            <diffuse>0.90 1.00 1.00 0.70</diffuse>
          </material>
        </visual>
        <visual name="near_ripple_right">
          <pose>0.22 -0.28 0.001 0 0 -0.16</pose>
          <geometry><box><size>0.70 0.012 0.002</size></box></geometry>
          <material>
            <ambient>0.90 1.00 1.00 0.70</ambient>
            <diffuse>0.90 1.00 1.00 0.70</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
