<?xml version="1.0"?>
<sdf version="1.9">
  <world name="atawi_3a3_ocean_world">
    <gravity>0 0 -9.81</gravity>

    <!-- ======================== SYSTEM PLUGINS (Gazebo Harmonic) ======================== -->
    <!-- Obligatoires : sans eux la simulation ne tourne pas et les modeles ne sont
         pas diffuses (spawn / controller_manager indisponibles en headless/Docker). -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Flottaison reelle : surface d'eau a z=0. En dessous = eau (1000 kg/m3),
         au-dessus = air (~1.2 kg/m3). Les corps non statiques flottent a l'equilibre. -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <!-- ======================== PHYSICS ======================== -->
    <!-- Le moteur (dartsim par defaut) est choisi par le plugin Physics ci-dessus. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ======================== SCENE / SKY ======================== -->
    <scene>
      <ambient>0.55 0.65 0.75 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ======================== LIGHTING ======================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 0.95 0.82 1</diffuse>
      <specular>0.55 0.55 0.50 1</specular>
      <direction>-0.35 0.20 -0.92</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ======================== WATER SURFACE ======================== -->
    <!-- Plan d'eau purement visuel. La flottaison est geree par le plugin Buoyancy. -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="water_link">
        <!-- Pas de collision : la surface est PUREMENT visuelle. La portance est
             assuree par le plugin Buoyancy (surface a z=0), pas par un plan solide. -->
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.18 0.30 1</ambient>
            <diffuse>0.02 0.35 0.62 1</diffuse>
            <specular>0.70 0.90 1.00 1</specular>
            <emissive>0.00 0.04 0.08 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== SUBTLE WAVE MARKERS ======================== -->
    <!-- Lightweight visual-only strips to suggest a sea surface. -->
    <model name="wave_lines">
      <static>true</static>
      <pose>0 0 0.003 0 0 0</pose>
      <link name="wave_link">
        <visual name="wave_line_1">
          <pose>0 -3 0 0 0 0.08</pose>
          <geometry><box><size>18 0.025 0.002</size></box></geometry>
          <material>
            <ambient>0.70 0.95 1.00 1</ambient>
            <diffuse>0.70 0.95 1.00 1</diffuse>
          </material>
        </visual>
        <visual name="wave_line_2">
          <pose>0 0 0 0 0 -0.06</pose>
          <geometry><box><size>18 0.025 0.002</size></box></geometry>
          <material>
            <ambient>0.70 0.95 1.00 1</ambient>
            <diffuse>0.70 0.95 1.00 1</diffuse>
          </material>
        </visual>
        <visual name="wave_line_3">
          <pose>0 3 0 0 0 0.10</pose>
          <geometry><box><size>18 0.025 0.002</size></box></geometry>
          <material>
            <ambient>0.70 0.95 1.00 1</ambient>
            <diffuse>0.70 0.95 1.00 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
